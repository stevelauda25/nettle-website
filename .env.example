# Review Mode (internal staging comments). See AGENTS.md → "Review Mode".

# "true" shows the review toolbar and enables /api/review/*. Anything else disables both.
# Build-time variable: redeploy after changing it on Vercel.
NEXT_PUBLIC_REVIEW_MODE=false

# Postgres connection string (Neon via the Vercel Marketplace integration sets this automatically).
# Server-only. Never commit a real value.
DATABASE_URL=

# Optional. Scopes comments; defaults to "staging" on Vercel and "development" locally.
# REVIEW_ENVIRONMENT=staging
